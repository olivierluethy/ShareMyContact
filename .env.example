# URL of the backend contact-form handler (PHP).
# Leave unset to use the production default https://sharemycontact.com/contact.php
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Base URL of the privacy-respecting analytics + bespoke-leads PHP API
# (the api-php/ folder uploaded to your shared host). No trailing slash.
# Example: https://api.sharemycontact.com
NEXT_PUBLIC_SMC_API_BASE=https://api.sharemycontact.com
